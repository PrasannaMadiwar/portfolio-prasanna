---
import { siteConfig } from "../config";
---

<section id="about" class="section-shell bg-[#0a0e1a] text-slate-100 border-t border-slate-850">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4 space-y-6">
        <div>
          <p class="eyebrow">01 / profile</p>
          <h2 class="section-title text-white">About Me</h2>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-[#0d1527] p-5 shadow-lg space-y-4">
          <div class="flex items-center gap-3.5">
            <img
              src={siteConfig.avatar || "/profile.jpg"}
              alt={siteConfig.name}
              class="w-12 h-12 rounded-xl object-cover object-top border border-teal-500/40 shadow-xs"
            />
            <div>
              <h3 class="font-bold text-white text-base">{siteConfig.name}</h3>
              <p class="text-xs text-teal-400 font-mono font-medium">B.Tech AI/ML @ VIT Pune</p>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-800 flex flex-wrap gap-2 text-xs font-mono text-slate-400">
            <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">Pune, India</span>
            <span class="px-2 py-0.5 rounded bg-teal-950/70 border border-teal-800/60 text-teal-300 font-semibold">CGPA 9.33 / 10</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-6">
        <p class="text-lg sm:text-xl leading-relaxed text-slate-300 font-normal">
          {siteConfig.aboutMe}
        </p>
      </div>
    </div>
  </div>
</section>
