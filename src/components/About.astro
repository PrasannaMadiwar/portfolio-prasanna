---
import { siteConfig } from "../config";
---

<section id="about" class="section-shell">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4 space-y-6">
        <div>
          <p class="eyebrow">01 / profile</p>
          <h2 class="section-title">About Me</h2>
        </div>

        <div class="rounded-2xl border border-teal-200 bg-white p-4 shadow-xs space-y-4">
          <div class="flex items-center gap-3.5">
            <img
              src={siteConfig.avatar || "/profile.jpg"}
              alt={siteConfig.name}
              class="w-14 h-14 rounded-xl object-cover object-top border border-teal-300 shadow-xs"
            />
            <div>
              <h3 class="font-bold text-slate-900 text-base">{siteConfig.name}</h3>
              <p class="text-xs text-teal-800 font-mono font-medium">B.Tech AI/ML @ VIT Pune</p>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-100 flex flex-wrap gap-2 text-xs font-mono text-slate-600">
            <span class="px-2 py-0.5 rounded bg-slate-100">Pune, India</span>
            <span class="px-2 py-0.5 rounded bg-teal-50 text-teal-800 font-semibold">CGPA 9.33 / 10</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
          {siteConfig.aboutMe}
        </p>
      </div>
    </div>
  </div>
</section>
