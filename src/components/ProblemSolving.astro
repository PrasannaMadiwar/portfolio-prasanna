---
import { siteConfig } from "../config";

const stats = siteConfig.problemSolving;
const username = new URL(stats.link).pathname.split("/").filter(Boolean).pop() ?? "LzLJWzHwdb";

const initialSolved = stats.solved ?? 261;
const initialEasy = stats.easy ?? 93;
const initialMedium = stats.medium ?? 143;
const initialHard = stats.hard ?? 25;
const initialSubmissions = stats.submissions ?? 846;
const initialAcceptance = stats.acceptance ?? "60.52%";
const initialRanking = stats.ranking ? stats.ranking.toLocaleString("en-IN") : "616,281";

const initialRecent = [
  { title: "Climbing Stairs", slug: "climbing-stairs", lang: "Python 3", difficulty: "Easy" },
  { title: "Min Cost to Connect All Points", slug: "min-cost-to-connect-all-points", lang: "Python 3", difficulty: "Medium" },
  { title: "Critical Connections in a Network", slug: "critical-connections-in-a-network", lang: "Python 3", difficulty: "Hard" },
  { title: "Swim in Rising Water", slug: "swim-in-rising-water", lang: "Python 3", difficulty: "Hard" },
  { title: "Making A Large Island", slug: "making-a-large-island", lang: "Python 3", difficulty: "Hard" },
];
---

<section
  id="problem-solving"
  class="section-shell bg-teal-50/60"
  data-leetcode-section
  data-leetcode-username={username}
>
  <div class="section-grid">
    <div>
      <p class="eyebrow">03 / practice</p>
      <h2 class="section-title">Problem Solving</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
        Live LeetCode progress for Data Structures & Algorithms practice, with active focus on Medium and Hard algorithmic problem solving.
      </p>

      <!-- Live Sync Status Indicator -->
      <div class="mt-5 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide border border-teal-200 bg-white/90 backdrop-blur-xs shadow-xs">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" data-leetcode-pulse></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500" data-leetcode-dot></span>
        </span>
        <span class="text-teal-900 font-mono" data-leetcode-status>Live LeetCode Sync Active</span>
      </div>

      <div class="mt-3 text-xs text-slate-500 font-mono flex flex-wrap items-center gap-2">
        <span>LeetCode: <strong class="text-slate-800">@{username}</strong></span>
        <span class="text-slate-300">•</span>
        <span>Global Rank: <strong class="text-teal-800 font-bold" data-leetcode-stat="ranking">#{initialRanking}</strong></span>
      </div>

      <a class="inline-link mt-6 group" href={stats.link} target="_blank" rel="noopener noreferrer">
        <span>View LeetCode Profile</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="space-y-6">
      <!-- Main Stats Grid -->
      <div class="grid grid-cols-2 gap-px overflow-hidden border border-teal-200 bg-teal-200 shadow-xs sm:grid-cols-4 rounded-xl">
        <div class="stat stat-featured col-span-2 sm:col-span-2 p-5 bg-teal-800 text-white">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-wider font-semibold text-teal-100">Total Solved</span>
            <span class="text-xs px-2 py-0.5 rounded bg-teal-700/80 font-mono text-teal-100">Top Rank</span>
          </div>
          <strong class="text-3xl sm:text-4xl mt-2 font-bold tracking-tight text-white" data-leetcode-stat="solved">
            {initialSolved}
          </strong>
          <span class="text-xs text-teal-100/90 mt-1">Verified DSA solutions</span>
        </div>

        <div class="stat p-4 bg-white">
          <span class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Medium</span>
          <strong class="text-2xl font-bold text-slate-900 mt-1" data-leetcode-stat="medium">
            {initialMedium}
          </strong>
          <span class="text-xs text-slate-500">Core focus</span>
        </div>

        <div class="stat p-4 bg-white">
          <span class="text-xs font-semibold text-rose-700 uppercase tracking-wider">Hard</span>
          <strong class="text-2xl font-bold text-slate-900 mt-1" data-leetcode-stat="hard">
            {initialHard}
          </strong>
          <span class="text-xs text-slate-500">Advanced</span>
        </div>

        <div class="stat p-4 bg-white">
          <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Easy</span>
          <strong class="text-2xl font-bold text-slate-900 mt-1" data-leetcode-stat="easy">
            {initialEasy}
          </strong>
          <span class="text-xs text-slate-500">Fundamentals</span>
        </div>

        <div class="stat p-4 bg-white">
          <span class="text-xs font-semibold text-slate-600 uppercase tracking-wider">Submissions</span>
          <strong class="text-2xl font-bold text-slate-900 mt-1" data-leetcode-stat="submissions">
            {initialSubmissions}
          </strong>
          <span class="text-xs text-slate-500">Total runs</span>
        </div>

        <div class="stat p-4 bg-white col-span-2">
          <span class="text-xs font-semibold text-teal-700 uppercase tracking-wider">Acceptance Rate</span>
          <strong class="text-2xl font-bold text-slate-900 mt-1" data-leetcode-stat="acceptance">
            {initialAcceptance}
          </strong>
          <span class="text-xs text-slate-500">Overall solution efficiency</span>
        </div>
      </div>

      <!-- Difficulty Breakdown Bars -->
      <div class="bg-white border border-teal-200 rounded-xl p-5 shadow-xs">
        <div class="flex items-center justify-between text-xs font-mono font-semibold text-slate-700 mb-3">
          <span>DIFFICULTY DISTRIBUTION</span>
          <span class="text-teal-700">Live Metric</span>
        </div>
        <div class="h-3 w-full rounded-full bg-slate-100 overflow-hidden flex">
          <div
            id="bar-easy"
            class="bg-emerald-500 transition-all duration-500"
            style={`width: ${((initialEasy / initialSolved) * 100).toFixed(1)}%`}
            title={`Easy: ${initialEasy}`}
          ></div>
          <div
            id="bar-medium"
            class="bg-amber-500 transition-all duration-500"
            style={`width: ${((initialMedium / initialSolved) * 100).toFixed(1)}%`}
            title={`Medium: ${initialMedium}`}
          ></div>
          <div
            id="bar-hard"
            class="bg-rose-500 transition-all duration-500"
            style={`width: ${((initialHard / initialSolved) * 100).toFixed(1)}%`}
            title={`Hard: ${initialHard}`}
          ></div>
        </div>
        <div class="mt-3 grid grid-cols-3 text-xs font-mono text-slate-600 pt-1 border-t border-slate-100">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Easy: <strong class="text-slate-800" data-leetcode-bar-val="easy">{initialEasy}</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Med: <strong class="text-slate-800" data-leetcode-bar-val="medium">{initialMedium}</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span>Hard: <strong class="text-slate-800" data-leetcode-bar-val="hard">{initialHard}</strong></span>
          </div>
        </div>
      </div>

      <!-- Recent Solved Problems Feed -->
      <div class="bg-white border border-teal-200 rounded-xl p-5 shadow-xs">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <h3 class="text-xs font-bold font-mono tracking-wider text-slate-700 uppercase">Recent Accepted Submissions</h3>
          </div>
          <span class="text-[11px] font-mono text-teal-700">Live Sync</span>
        </div>

        <ul class="divide-y divide-slate-100 mt-2 text-sm" data-leetcode-recent-list>
          {initialRecent.map((item) => (
            <li class="py-2.5 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <a
                  href={`https://leetcode.com/problems/${item.slug}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-slate-800 hover:text-teal-700 truncate transition-colors"
                >
                  {item.title}
                </a>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">
                  {item.lang}
                </span>
                <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
                  Accepted
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector("[data-leetcode-section]");
  const username = section?.getAttribute("data-leetcode-username") || "LzLJWzHwdb";
  const statusEl = section?.querySelector("[data-leetcode-status]");
  const pulseEl = section?.querySelector("[data-leetcode-pulse]");
  const dotEl = section?.querySelector("[data-leetcode-dot]");
  const recentListEl = section?.querySelector("[data-leetcode-recent-list]");

  const setStat = (key: string, value: any) => {
    const element = section?.querySelector(`[data-leetcode-stat="${key}"]`);
    if (element && value !== undefined && value !== null && value !== "") {
      element.textContent = String(value);
    }
  };

  const formatNumber = (value: any) =>
    typeof value === "number" ? value.toLocaleString("en-IN") : value;

  const updateDistributionBars = (easy: number, medium: number, hard: number) => {
    const total = easy + medium + hard;
    if (total <= 0) return;

    const barEasy = document.getElementById("bar-easy");
    const barMed = document.getElementById("bar-medium");
    const barHard = document.getElementById("bar-hard");

    if (barEasy) barEasy.style.width = `${((easy / total) * 100).toFixed(1)}%`;
    if (barMed) barMed.style.width = `${((medium / total) * 100).toFixed(1)}%`;
    if (barHard) barHard.style.width = `${((hard / total) * 100).toFixed(1)}%`;

    const elEasy = section?.querySelector('[data-leetcode-bar-val="easy"]');
    const elMed = section?.querySelector('[data-leetcode-bar-val="medium"]');
    const elHard = section?.querySelector('[data-leetcode-bar-val="hard"]');

    if (elEasy) elEasy.textContent = String(easy);
    if (elMed) elMed.textContent = String(medium);
    if (elHard) elHard.textContent = String(hard);
  };

  const renderRecentSubmissions = (submissions: any[]) => {
    if (!recentListEl || !Array.isArray(submissions) || submissions.length === 0) return;

    // Filter only accepted submissions and deduplicate by title
    const seen = new Set();
    const accepted = submissions.filter((s) => {
      const isAcc = (s.statusDisplay || "").toLowerCase() === "accepted";
      if (!isAcc || seen.has(s.title)) return false;
      seen.add(s.title);
      return true;
    }).slice(0, 5);

    if (accepted.length === 0) return;

    recentListEl.innerHTML = accepted.map((sub: any) => `
      <li class="py-2.5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <a
            href="https://leetcode.com/problems/${sub.titleSlug || ""}/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-800 hover:text-teal-700 truncate transition-colors"
          >
            ${sub.title}
          </a>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">
            ${sub.lang === "python3" ? "Python 3" : sub.lang || "Code"}
          </span>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
            Accepted
          </span>
        </div>
      </li>
    `).join("");
  };

  const fetchWithTimeout = async (url: string, timeoutMs = 6000) => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const res = await fetch(url, { signal: controller.signal, headers: { Accept: "application/json" } });
      clearTimeout(timeoutId);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return await res.json();
    } catch (err) {
      clearTimeout(timeoutId);
      throw err;
    }
  };

  const applyData = (data: any) => {
    const totalSolved = data.totalSolved;
    const easy = data.easySolved ?? data.byDifficulty?.easy ?? 0;
    const medium = data.mediumSolved ?? data.byDifficulty?.medium ?? 0;
    const hard = data.hardSolved ?? data.byDifficulty?.hard ?? 0;

    let ranking = data.ranking;
    let submissions = data.totalSubmissions?.[0]?.submissions ?? data.totalSubmissionNum?.[0]?.submissions;
    let acceptance = data.acceptanceRate;

    if (!acceptance && data.matchedUserStats) {
      const acTotal = data.matchedUserStats.acSubmissionNum?.find((s: any) => s.difficulty === "All")?.submissions ?? 0;
      const subTotal = data.matchedUserStats.totalSubmissionNum?.find((s: any) => s.difficulty === "All")?.submissions ?? 0;
      if (subTotal > 0) {
        acceptance = `${((acTotal / subTotal) * 100).toFixed(2)}%`;
      }
    }

    if (totalSolved !== undefined) setStat("solved", formatNumber(totalSolved));
    if (easy !== undefined) setStat("easy", formatNumber(easy));
    if (medium !== undefined) setStat("medium", formatNumber(medium));
    if (hard !== undefined) setStat("hard", formatNumber(hard));
    if (ranking !== undefined) setStat("ranking", `#${formatNumber(ranking)}`);
    if (submissions !== undefined) setStat("submissions", formatNumber(submissions));
    if (acceptance !== undefined) {
      setStat("acceptance", typeof acceptance === "number" ? `${acceptance.toFixed(2)}%` : String(acceptance));
    }

    if (easy && medium && hard) {
      updateDistributionBars(easy, medium, hard);
    }

    if (data.recentSubmissions && Array.isArray(data.recentSubmissions)) {
      renderRecentSubmissions(data.recentSubmissions);
    }
  };

  const loadLeetCodeStats = async () => {
    if (!username) return;

    // Fast load from session/local storage if fresh (< 1 hour)
    const CACHE_KEY = `lc_stats_${username}`;
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const { timestamp, payload } = JSON.parse(cached);
        if (Date.now() - timestamp < 3600000) {
          applyData(payload);
          if (statusEl) statusEl.textContent = "Live LeetCode Sync Active";
        }
      }
    } catch {}

    // Multi-source fallback: Primary is fast Faisal Shohag API, fallback is Alfa API
    const endpoints = [
      `https://leetcode-api-faisalshohag.vercel.app/${username}`,
      `https://alfa-leetcode-api.onrender.com/userProfile/${username}`,
    ];

    let liveData = null;

    for (const url of endpoints) {
      try {
        const json = await fetchWithTimeout(url, 6000);
        if (json && (json.totalSolved !== undefined || json.data)) {
          liveData = json.data || json;
          break;
        }
      } catch (e) {
        // Try next fallback
      }
    }

    if (liveData) {
      applyData(liveData);
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), payload: liveData }));
      } catch {}

      if (statusEl) {
        const timeStr = new Date().toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
        statusEl.textContent = `Live LeetCode Sync Active (${timeStr})`;
      }
      if (pulseEl) pulseEl.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
      if (dotEl) dotEl.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500";
    } else {
      // Offline or rate-limited: keep graceful saved stats
      if (statusEl) statusEl.textContent = "Synced with verified record";
      if (pulseEl) pulseEl.className = "hidden";
      if (dotEl) dotEl.className = "relative inline-flex rounded-full h-2.5 w-2.5 bg-teal-600";
    }
  };

  loadLeetCodeStats();
</script>

