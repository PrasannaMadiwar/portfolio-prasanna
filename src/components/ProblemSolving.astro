---
import { siteConfig } from "../config";

const stats = siteConfig.problemSolving;
const username = new URL(stats.link).pathname.split("/").filter(Boolean).pop() ?? "LzLJWzHwdb";
const tufUsername = stats.tufUsername ?? "prasannamadiwar";
const codechefUsername = stats.codechefUsername ?? "prasanna_m146";

const initialSolved = stats.solved ?? 352;
const initialEasy = stats.easy ?? 116;
const initialMedium = stats.medium ?? 192;
const initialHard = stats.hard ?? 44;
const initialSubmissions = stats.submissions ?? 1157;
const initialAcceptance = stats.acceptance ?? "60.52%";
const initialRanking = stats.ranking ? stats.ranking.toLocaleString("en-IN") : "405,255";

let initialTufSolved = stats.tufPlusScore ?? 513;
let initialTufTotal = stats.tufTotalQuestions ?? 1494;

// CodeChef stats: Separate DSA Challenge rating (1600 3★) from Starters Contest rating (1124 1★)
let initialCodechefDsaRating = stats.codechefDsaRatingNumber ? String(stats.codechefDsaRatingNumber) : "1600";
let initialCodechefDsaStars = stats.codechefDsaStars ?? "3★";
let initialCodechefDsaRank = stats.codechefDsaGlobalRank ?? "4,642";
let initialCodechefDsaMaxRating = stats.codechefDsaMaxRating ?? "1600";

let initialCodechefNormalRating = stats.codechefNormalRatingNumber ? String(stats.codechefNormalRatingNumber) : "1124";
let initialCodechefNormalStars = stats.codechefNormalStars ?? "1★";
let initialCodechefNormalRank = stats.codechefGlobalRank ?? "1,11,226";
let initialCodechefNormalMaxRating = stats.codechefMaxRating ?? "1124";

// Build-time pre-fetch
try {
  const tufRes = await fetch(`https://tuf-stats.tashif.codes/${tufUsername}/stats`, {
    signal: AbortSignal.timeout(3500),
  });
  if (tufRes.ok) {
    const tufJson = await tufRes.json();
    if (tufJson.data?.totalSolved) {
      initialTufSolved = tufJson.data.totalSolved;
      initialTufTotal = tufJson.data.totalQuestions ?? initialTufTotal;
    }
  }
} catch {}

try {
  const ccRes = await fetch(`https://competeapi.vercel.app/user/codechef/${codechefUsername}/`, {
    signal: AbortSignal.timeout(3500),
  });
  if (ccRes.ok) {
    const ccJson = await ccRes.json();
    if (ccJson.rating_number) {
      initialCodechefNormalRating = String(ccJson.rating_number);
      initialCodechefNormalStars = ccJson.rating || "1★";
      initialCodechefNormalMaxRating = String(ccJson.max_rank ?? ccJson.rating_number);
      const gRank = parseInt(String(ccJson.global_rank).trim(), 10);
      if (!isNaN(gRank)) initialCodechefNormalRank = gRank.toLocaleString("en-IN");
    }
  }
} catch {}

const initialRecent = [
  { title: "Climbing Stairs", slug: "climbing-stairs", lang: "Python 3", difficulty: "Easy" },
  { title: "Min Cost to Connect All Points", slug: "min-cost-to-connect-all-points", lang: "Python 3", difficulty: "Medium" },
  { title: "Critical Connections in a Network", slug: "critical-connections-in-a-network", lang: "Python 3", difficulty: "Hard" },
  { title: "Swim in Rising Water", slug: "swim-in-rising-water", lang: "Python 3", difficulty: "Hard" },
  { title: "Making A Large Island", slug: "making-a-large-island", lang: "Python 3", difficulty: "Hard" },
];

const tufPercent = ((initialTufSolved / initialTufTotal) * 100).toFixed(1);
---

<section
  id="problem-solving"
  class="section-shell bg-[#080b12] text-slate-100"
  data-dsa-section
  data-leetcode-username={username}
  data-tuf-username={tufUsername}
  data-codechef-username={codechefUsername}
>
  <div class="max-w-7xl mx-auto space-y-10">
    <!-- Section Header -->
    <div class="pb-6 border-b border-slate-800">
      <p class="eyebrow">03 / practice</p>
      <h2 class="section-title text-white">Problem Solving</h2>
      <p class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-slate-400">
        Data Structures & Algorithms across LeetCode, TakeUForward (TUF+), and CodeChef, focusing on competitive programming and system interview preparation.
      </p>
    </div>

    <!-- 3 Equal Box Size Cards for LeetCode, TakeUForward (TUF+), and CodeChef -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
      
      <!-- BOX 1: LeetCode -->
      <div class="rounded-2xl border border-slate-800 bg-[#0d1527] p-6 shadow-xl flex flex-col justify-between h-full hover:border-slate-700 transition-all duration-300 relative group">
        <div>
          <!-- Platform Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
            <div class="flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-xs font-mono font-bold">LC</span>
              <div>
                <h3 class="font-bold text-white text-base">LeetCode</h3>
                <span class="text-[11px] font-mono text-slate-400">@{username}</span>
              </div>
            </div>
          </div>

          <!-- Hero Highlight Metric -->
          <div class="mt-5">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Total Solved</span>
            <div class="flex items-baseline gap-2 mt-1">
              <strong class="text-4xl sm:text-5xl font-bold tracking-tight text-white font-mono" data-leetcode-stat="solved">{initialSolved}</strong>
              <span class="text-xs font-mono text-slate-400">problems</span>
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="mt-5 grid grid-cols-3 gap-2 p-3 rounded-xl bg-slate-900/90 border border-slate-800">
            <div class="text-center">
              <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-400 block font-semibold">Easy</span>
              <strong class="text-lg font-bold text-white font-mono" data-leetcode-stat="easy">{initialEasy}</strong>
            </div>
            <div class="text-center border-x border-slate-800">
              <span class="text-[10px] uppercase font-mono tracking-wider text-amber-400 block font-semibold">Medium</span>
              <strong class="text-lg font-bold text-white font-mono" data-leetcode-stat="medium">{initialMedium}</strong>
            </div>
            <div class="text-center">
              <span class="text-[10px] uppercase font-mono tracking-wider text-rose-400 block font-semibold">Hard</span>
              <strong class="text-lg font-bold text-white font-mono" data-leetcode-stat="hard">{initialHard}</strong>
            </div>
          </div>

          <!-- Meta rows -->
          <div class="mt-4 space-y-2 text-xs font-mono text-slate-400">
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>Global Rank:</span>
              <strong class="text-slate-200" data-leetcode-stat="ranking">#{initialRanking}</strong>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>Acceptance Rate:</span>
              <strong class="text-white" data-leetcode-stat="acceptance">{initialAcceptance}</strong>
            </div>
            <div class="flex items-center justify-between py-1">
              <span>Submissions:</span>
              <strong class="text-slate-300" data-leetcode-stat="submissions">{initialSubmissions}</strong>
            </div>
          </div>
        </div>

        <!-- Card Footer Action Link -->
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a
            href={stats.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between w-full text-xs font-mono font-semibold text-slate-300 hover:text-white transition-colors group/link"
          >
            <span>View LeetCode Profile</span>
            <span class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- BOX 2: TakeUForward / TUF+ -->
      <div class="rounded-2xl border border-slate-800 bg-[#0d1527] p-6 shadow-xl flex flex-col justify-between h-full hover:border-slate-700 transition-all duration-300 relative group">
        <div>
          <!-- Platform Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
            <div class="flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-xs font-mono font-bold">TUF+</span>
              <div>
                <h3 class="font-bold text-white text-base">TakeUForward</h3>
                <span class="text-[11px] font-mono text-slate-400">@{tufUsername}</span>
              </div>
            </div>
          </div>

          <!-- Hero Highlight Metric -->
          <div class="mt-5">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Problems Solved</span>
            <div class="flex items-baseline gap-2 mt-1">
              <strong class="text-4xl sm:text-5xl font-bold tracking-tight text-white font-mono" data-tuf-stat="score">{initialTufSolved}</strong>
              <span class="text-xs font-mono text-slate-400" data-tuf-stat="total">/ {initialTufTotal} questions</span>
            </div>
          </div>

          <!-- TUF Completion Bar Container -->
          <div class="mt-5 p-3 rounded-xl bg-slate-900/90 border border-slate-800">
            <div class="flex items-center justify-between text-xs font-mono text-slate-300 mb-2">
              <span>Sheet Progress</span>
              <strong class="text-teal-300" data-tuf-stat="percent">{tufPercent}% completed</strong>
            </div>
            <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
              <div
                class="bg-teal-500 h-2 rounded-full transition-all duration-700"
                data-tuf-bar
                style={`width: ${tufPercent}%`}
              ></div>
            </div>
          </div>

          <!-- Meta rows -->
          <div class="mt-4 space-y-2 text-xs font-mono text-slate-400">
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>TUF+ Profile Score:</span>
              <strong class="text-teal-300 font-bold" data-tuf-stat="solved">{initialTufSolved} pts</strong>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>DSA Curriculum:</span>
              <strong class="text-white">Striver's A2Z & SDE</strong>
            </div>
            <div class="flex items-center justify-between py-1">
              <span>Primary Language:</span>
              <strong class="text-slate-300">Python 3 & C++</strong>
            </div>
          </div>
        </div>

        <!-- Card Footer Action Link -->
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a
            href={siteConfig.social?.takeuforward || `https://takeuforward.org/profile/${tufUsername}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between w-full text-xs font-mono font-semibold text-slate-300 hover:text-white transition-colors group/link"
          >
            <span>View TUF+ Profile</span>
            <span class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- BOX 3: CodeChef -->
      <div class="rounded-2xl border border-slate-800 bg-[#0d1527] p-6 shadow-xl flex flex-col justify-between h-full hover:border-slate-700 transition-all duration-300 relative group">
        <div>
          <!-- Platform Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
            <div class="flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-xs font-mono font-bold">CC</span>
              <div>
                <h3 class="font-bold text-white text-base">CodeChef</h3>
                <span class="text-[11px] font-mono text-slate-400">@{codechefUsername}</span>
              </div>
            </div>
          </div>

          <!-- Hero Highlight Metric: DSA Rating -->
          <div class="mt-5">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">CodeChef DSA Rating</span>
            <div class="flex items-baseline gap-2.5 mt-1">
              <strong class="text-4xl sm:text-5xl font-bold tracking-tight text-white font-mono" data-codechef-stat="dsaRating">{initialCodechefDsaRating}</strong>
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-xs font-bold" data-codechef-stat="dsaStars">{initialCodechefDsaStars}</span>
            </div>
          </div>

          <!-- Dual Rating Grid: Separation of DSA & Contest Rating -->
          <div class="mt-5 grid grid-cols-2 gap-2 p-3 rounded-xl bg-slate-900/90 border border-slate-800">
            <div class="text-center border-r border-slate-800 pr-2">
              <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block font-semibold">DSA Rating</span>
              <strong class="text-base sm:text-lg font-bold text-white font-mono" data-codechef-stat="dsaGrid">{initialCodechefDsaRating} ({initialCodechefDsaStars})</strong>
              <span class="text-[10px] text-slate-400 block font-mono mt-0.5">Rank #{initialCodechefDsaRank}</span>
            </div>
            <div class="text-center pl-2">
              <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block font-semibold">Contest Rating</span>
              <strong class="text-base sm:text-lg font-bold text-white font-mono" data-codechef-stat="normalRating">{initialCodechefNormalRating} ({initialCodechefNormalStars})</strong>
              <span class="text-[10px] text-slate-400 block font-mono mt-0.5">Rank #{initialCodechefNormalRank}</span>
            </div>
          </div>

          <!-- Meta rows -->
          <div class="mt-4 space-y-2 text-xs font-mono text-slate-400">
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>DSA Global Rank:</span>
              <strong class="text-slate-200" data-codechef-stat="dsaRank">#{initialCodechefDsaRank}</strong>
            </div>
            <div class="flex items-center justify-between py-1 border-b border-slate-800/60">
              <span>DSA Challenge Peak:</span>
              <strong class="text-white" data-codechef-stat="dsaMax">{initialCodechefDsaMaxRating} (Rank #396)</strong>
            </div>
            <div class="flex items-center justify-between py-1">
              <span>Starters Rating:</span>
              <strong class="text-slate-300" data-codechef-stat="normalMeta">{initialCodechefNormalRating} (Peak {initialCodechefNormalMaxRating})</strong>
            </div>
          </div>
        </div>

        <!-- Card Footer Action Link -->
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a
            href={siteConfig.social?.codechef || `https://www.codechef.com/users/${codechefUsername}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between w-full text-xs font-mono font-semibold text-slate-300 hover:text-white transition-colors group/link"
          >
            <span>View CodeChef Profile</span>
            <span class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Secondary Row: Difficulty Distribution Bar & Recent Accepted Submissions in Dark Palette -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- LeetCode Difficulty Distribution -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-800 bg-[#0d1527] p-6 shadow-xl">
        <div class="flex items-center justify-between text-xs font-mono font-semibold text-slate-300 mb-4">
          <span class="uppercase tracking-wider">Difficulty Distribution</span>
        </div>

        <div class="h-3 w-full rounded-full bg-slate-800 overflow-hidden flex">
          <div
            id="bar-easy"
            class="bg-emerald-500 transition-all duration-500"
            style={`width: ${((initialEasy / initialSolved) * 100).toFixed(1)}%`}
            title={`Easy: ${initialEasy}`}
          ></div>
          <div
            id="bar-medium"
            class="bg-amber-500 transition-all duration-500"
            style={`width: ${((initialMedium / initialSolved) * 100).toFixed(1)}%`}
            title={`Medium: ${initialMedium}`}
          ></div>
          <div
            id="bar-hard"
            class="bg-rose-500 transition-all duration-500"
            style={`width: ${((initialHard / initialSolved) * 100).toFixed(1)}%`}
            title={`Hard: ${initialHard}`}
          ></div>
        </div>

        <div class="mt-4 grid grid-cols-3 text-xs font-mono text-slate-300 pt-3 border-t border-slate-800">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Easy: <strong class="text-white" data-leetcode-bar-val="easy">{initialEasy}</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Med: <strong class="text-white" data-leetcode-bar-val="medium">{initialMedium}</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span>Hard: <strong class="text-white" data-leetcode-bar-val="hard">{initialHard}</strong></span>
          </div>
        </div>
      </div>

      <!-- Recent Solved Problems Feed -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-800 bg-[#0d1527] p-6 shadow-xl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <h3 class="text-xs font-bold font-mono tracking-wider text-slate-200 uppercase">Recent Accepted Submissions</h3>
        </div>

        <ul class="divide-y divide-slate-800/80 mt-2 text-sm" data-leetcode-recent-list>
          {initialRecent.map((item) => (
            <li class="py-2.5 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <a
                  href={`https://leetcode.com/problems/${item.slug}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-slate-200 hover:text-teal-300 truncate transition-colors text-xs sm:text-sm"
                >
                  {item.title}
                </a>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">
                  {item.lang}
                </span>
                <span class="text-[10px] font-semibold text-emerald-300 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded">
                  Accepted
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector("[data-dsa-section]");
  const lcUsername = section?.getAttribute("data-leetcode-username") || "LzLJWzHwdb";
  const tufUsername = section?.getAttribute("data-tuf-username") || "prasannamadiwar";
  const ccUsername = section?.getAttribute("data-codechef-username") || "prasanna_m146";

  const statusEl = section?.querySelector("[data-sync-status]");
  const pulseEl = section?.querySelector("[data-sync-pulse]");
  const dotEl = section?.querySelector("[data-sync-dot]");
  const recentListEl = section?.querySelector("[data-leetcode-recent-list]");

  const setElText = (selector: string, value: any) => {
    const el = section?.querySelector(selector);
    if (el && value !== undefined && value !== null && value !== "") {
      el.textContent = String(value);
    }
  };

  const formatNumber = (value: any) =>
    typeof value === "number" ? value.toLocaleString("en-IN") : value;

  const updateDistributionBars = (easy: number, medium: number, hard: number) => {
    const total = easy + medium + hard;
    if (total <= 0) return;

    const barEasy = document.getElementById("bar-easy");
    const barMed = document.getElementById("bar-medium");
    const barHard = document.getElementById("bar-hard");

    if (barEasy) barEasy.style.width = `${((easy / total) * 100).toFixed(1)}%`;
    if (barMed) barMed.style.width = `${((medium / total) * 100).toFixed(1)}%`;
    if (barHard) barHard.style.width = `${((hard / total) * 100).toFixed(1)}%`;

    const elEasy = section?.querySelector('[data-leetcode-bar-val="easy"]');
    const elMed = section?.querySelector('[data-leetcode-bar-val="medium"]');
    const elHard = section?.querySelector('[data-leetcode-bar-val="hard"]');

    if (elEasy) elEasy.textContent = String(easy);
    if (elMed) elMed.textContent = String(medium);
    if (elHard) elHard.textContent = String(hard);
  };

  const renderRecentSubmissions = (submissions: any[]) => {
    if (!recentListEl || !Array.isArray(submissions) || submissions.length === 0) return;

    const seen = new Set();
    const accepted = submissions.filter((s) => {
      const isAcc = (s.statusDisplay || "").toLowerCase() === "accepted";
      if (!isAcc || seen.has(s.title)) return false;
      seen.add(s.title);
      return true;
    }).slice(0, 5);

    if (accepted.length === 0) return;

    recentListEl.innerHTML = accepted.map((sub: any) => `
      <li class="py-2.5 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <a
            href="https://leetcode.com/problems/${sub.titleSlug || ""}/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-200 hover:text-teal-300 truncate transition-colors text-xs sm:text-sm"
          >
            ${sub.title}
          </a>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">
            ${sub.lang === "python3" ? "Python 3" : sub.lang || "Code"}
          </span>
          <span class="text-[10px] font-semibold text-emerald-300 bg-emerald-950/60 border border-emerald-800/60 px-2 py-0.5 rounded">
            Accepted
          </span>
        </div>
      </li>
    `).join("");
  };

  const fetchWithTimeout = async (url: string, timeoutMs = 6000) => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const res = await fetch(url, { signal: controller.signal, headers: { Accept: "application/json" } });
      clearTimeout(timeoutId);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return await res.json();
    } catch (err) {
      clearTimeout(timeoutId);
      throw err;
    }
  };

  // 1. LEETCODE REAL-TIME SYNC
  const applyLeetCodeData = (data: any) => {
    const totalSolved = data.totalSolved;
    const easy = data.easySolved ?? data.byDifficulty?.easy ?? 0;
    const medium = data.mediumSolved ?? data.byDifficulty?.medium ?? 0;
    const hard = data.hardSolved ?? data.byDifficulty?.hard ?? 0;

    let ranking = data.ranking;
    let submissions = data.totalSubmissions?.[0]?.submissions ?? data.totalSubmissionNum?.[0]?.submissions;
    let acceptance = data.acceptanceRate;

    if (!acceptance && data.matchedUserStats) {
      const acTotal = data.matchedUserStats.acSubmissionNum?.find((s: any) => s.difficulty === "All")?.submissions ?? 0;
      const subTotal = data.matchedUserStats.totalSubmissionNum?.find((s: any) => s.difficulty === "All")?.submissions ?? 0;
      if (subTotal > 0) {
        acceptance = `${((acTotal / subTotal) * 100).toFixed(2)}%`;
      }
    }

    if (totalSolved !== undefined) setElText('[data-leetcode-stat="solved"]', formatNumber(totalSolved));
    if (easy !== undefined) setElText('[data-leetcode-stat="easy"]', formatNumber(easy));
    if (medium !== undefined) setElText('[data-leetcode-stat="medium"]', formatNumber(medium));
    if (hard !== undefined) setElText('[data-leetcode-stat="hard"]', formatNumber(hard));
    if (ranking !== undefined) setElText('[data-leetcode-stat="ranking"]', `#${formatNumber(ranking)}`);
    if (submissions !== undefined) setElText('[data-leetcode-stat="submissions"]', formatNumber(submissions));
    if (acceptance !== undefined) {
      setElText('[data-leetcode-stat="acceptance"]', typeof acceptance === "number" ? `${acceptance.toFixed(2)}%` : String(acceptance));
    }

    if (easy && medium && hard) {
      updateDistributionBars(easy, medium, hard);
    }

    if (data.recentSubmissions && Array.isArray(data.recentSubmissions)) {
      renderRecentSubmissions(data.recentSubmissions);
    }
  };

  const loadLeetCodeStats = async () => {
    if (!lcUsername) return;
    const CACHE_KEY = `lc_stats_${lcUsername}`;
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const { timestamp, payload } = JSON.parse(cached);
        if (Date.now() - timestamp < 1800000) {
          applyLeetCodeData(payload);
        }
      }
    } catch {}

    const endpoints = [
      `https://leetcode-api-faisalshohag.vercel.app/${lcUsername}`,
      `https://alfa-leetcode-api.onrender.com/userProfile/${lcUsername}`,
    ];

    let liveData = null;
    for (const url of endpoints) {
      try {
        const json = await fetchWithTimeout(url, 6000);
        if (json && (json.totalSolved || json.data?.totalSolved)) {
          liveData = json.data || json;
          break;
        }
      } catch {}
    }

    if (liveData) {
      applyLeetCodeData(liveData);
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), payload: liveData }));
      } catch {}
    }
  };

  // 2. TAKEUFORWARD (TUF+) REAL-TIME SYNC
  const applyTufData = (tufData: any) => {
    const solved = tufData.totalSolved ?? tufData.total_solved;
    const total = tufData.totalQuestions ?? tufData.total_dsa ?? 1494;

    if (solved !== undefined) {
      setElText('[data-tuf-stat="score"]', formatNumber(solved));
      setElText('[data-tuf-stat="solved"]', `${formatNumber(solved)} pts`);
      setElText('[data-tuf-stat="total"]', `/ ${formatNumber(total)} Target`);

      const pct = ((solved / total) * 100).toFixed(1);
      setElText('[data-tuf-stat="percent"]', `${pct}% completed`);

      const bar = section?.querySelector("[data-tuf-bar]") as HTMLElement | null;
      if (bar) bar.style.width = `${pct}%`;
    }
  };

  const loadTufStats = async () => {
    if (!tufUsername) return;
    const CACHE_KEY = `tuf_stats_${tufUsername}`;
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const { timestamp, payload } = JSON.parse(cached);
        if (Date.now() - timestamp < 1800000) {
          applyTufData(payload);
        }
      }
    } catch {}

    const endpoints = [
      `https://tuf-stats.tashif.codes/${tufUsername}/stats`,
    ];

    for (const url of endpoints) {
      try {
        const json = await fetchWithTimeout(url, 5000);
        if (json && json.data?.totalSolved) {
          applyTufData(json.data);
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), payload: json.data }));
          } catch {}
          break;
        }
      } catch {}
    }
  };

  // 3. CODECHEF REAL-TIME SYNC (DSA & CONTEST RATING)
  const applyCodeChefData = (ccData: any) => {
    // If the API payload specifically has DSA-specific fields (e.g. from dsa_monday)
    const dsaRating = ccData.dsa_rating ?? ccData.dsaRating;
    const dsaStars = ccData.dsa_stars ?? ccData.dsaStars;
    const dsaRank = ccData.dsa_rank ?? ccData.dsaRank;
    const dsaMax = ccData.dsa_max ?? ccData.dsaMaxRating;

    if (dsaRating !== undefined) {
      setElText('[data-codechef-stat="dsaRating"]', formatNumber(dsaRating));
      setElText('[data-codechef-stat="dsaGrid"]', `${formatNumber(dsaRating)} (${dsaStars || "3★"})`);
    }
    if (dsaStars) setElText('[data-codechef-stat="dsaStars"]', String(dsaStars).trim());
    if (dsaRank) setElText('[data-codechef-stat="dsaRank"]', `#${formatNumber(dsaRank)}`);
    if (dsaMax) setElText('[data-codechef-stat="dsaMax"]', `${formatNumber(dsaMax)} (Rank #396)`);

    // Normal / Starters contest rating
    const normalRating = ccData.rating_number ?? ccData.currentRating;
    const normalStars = ccData.rating ?? ccData.stars ?? "1★";
    const normalMax = ccData.max_rank ?? ccData.highestRating ?? normalRating;
    let normalGlobalRank = ccData.global_rank ?? ccData.globalRank;

    if (normalRating !== undefined) {
      setElText('[data-codechef-stat="normalRating"]', `${formatNumber(normalRating)} (${String(normalStars).trim()})`);
      setElText('[data-codechef-stat="normalMeta"]', `${formatNumber(normalRating)} (Peak ${formatNumber(normalMax)})`);
    }
  };

  const loadCodeChefStats = async () => {
    if (!ccUsername) return;
    const CACHE_KEY = `codechef_stats_v3_${ccUsername}`;
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const { timestamp, payload } = JSON.parse(cached);
        if (Date.now() - timestamp < 1800000) {
          applyCodeChefData(payload);
        }
      }
    } catch {}

    const endpoints = [
      `https://competeapi.vercel.app/user/codechef/${ccUsername}/`,
    ];

    for (const url of endpoints) {
      try {
        const json = await fetchWithTimeout(url, 6000);
        if (json && json.rating_number) {
          applyCodeChefData(json);
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), payload: json }));
          } catch {}
          break;
        }
      } catch {}
    }
  };

  const initSync = async () => {
    await Promise.allSettled([
      loadLeetCodeStats(),
      loadTufStats(),
      loadCodeChefStats(),
    ]);
  };

  initSync();
</script>
