---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#080b12] py-16 sm:py-20 md:py-24 min-h-[90vh] flex items-center text-slate-100"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Sleek dark radial glow overlay -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style={`background: radial-gradient(circle 800px at 15% 20%, rgba(15, 118, 110, 0.22) 0%, rgba(13, 21, 39, 0.4) 45%, #080b12 100%)`}
  >
  </div>

  <!-- Subtle Dark Background Grid -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-slate-800/30 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="hero-grid"
        width={120}
        height={120}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 120V.5H120" fill="none"></path>
      </pattern>
    </defs>
    <rect fill="url(#hero-grid)" width="100%" height="100%"></rect>
  </svg>

  <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-14 w-full py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Intro & Info -->
      <div class="lg:col-span-8 space-y-5">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
          <span>Available for Internships • Summer 2027</span>
        </div>

        <div>
          <h2 class="text-slate-400 text-base sm:text-lg font-medium tracking-wide animate-fade-in">
            Hello! 👋
          </h2>
          <h1 class="mt-2 text-pretty text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white animate-fade-in animation-delay-200">
            I'm <span class="text-white">{siteConfig.name}</span>
          </h1>
          <p class="mt-4 text-pretty text-base sm:text-lg md:text-xl leading-relaxed text-slate-300 font-normal animate-fade-in animation-delay-400 max-w-2xl">
            {siteConfig.title}
          </p>
        </div>

        <!-- Quick Highlight Badges -->
        <div class="flex flex-wrap gap-2 text-xs font-mono animate-fade-in animation-delay-400 pt-1">
          <span class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
            VIT Pune • CGPA 9.33
          </span>
          <span class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
            ICST 2026 Researcher (IIT Patna)
          </span>
          <span class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
            513 TUF+ • 352 LeetCode • 1600 CodeChef DSA
          </span>
        </div>

        <!-- Call to actions -->
        <div class="pt-2 flex flex-wrap items-center gap-3 animate-fade-in animation-delay-600">
          <a
            href="#projects"
            class="px-5 py-2.5 rounded-lg text-white font-medium text-sm transition-all bg-teal-600 hover:bg-teal-500 shadow-sm"
          >
            Explore Projects →
          </a>
          <a
            href="#problem-solving"
            class="px-5 py-2.5 rounded-lg border border-slate-700 text-slate-200 font-medium text-sm bg-slate-900 hover:bg-slate-800 transition-colors shadow-sm"
          >
            Problem Solving →
          </a>
        </div>

        <!-- Social Icons -->
        <div class="pt-4 flex flex-wrap gap-x-4 gap-y-3 text-slate-400 animate-fade-in animation-delay-600 items-center">
          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                title="Email Prasanna"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                title="GitHub Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.leetcode && (
              <a
                href={siteConfig.social.leetcode}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LeetCode"
                title="LeetCode Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-amber-500 hover:text-amber-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-3.3-.5-5-2.2-5-5V8l3-3h5a5 5 0 0 1 5 5v1" />
                  <path d="M8 12h8m-8 4h5" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.takeuforward && (
              <a
                href={siteConfig.social.takeuforward}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TakeUForward"
                title="TakeUForward Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 transition-all duration-200 font-mono text-xs font-bold"
              >
                <span class="inline-block px-1.5 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-800">TUF</span>
              </a>
            )
          }
          {
            siteConfig.social?.codechef && (
              <a
                href={siteConfig.social.codechef}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="CodeChef"
                title="CodeChef Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-amber-500 hover:text-amber-300 transition-all duration-200 font-mono text-xs font-bold"
              >
                <span class="inline-block px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800">CC</span>
              </a>
            )
          }
        </div>
      </div>

      <!-- Right Column: Clean Professional Portrait Presentation -->
      <div class="lg:col-span-4 flex justify-center lg:justify-end animate-fade-in animation-delay-200">
        <div class="relative group w-48 sm:w-56 md:w-60">
          <div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-xl transition-all duration-300 group-hover:border-slate-700">
            <!-- Aspect Ratio constrained for clean profile view -->
            <div class="aspect-[4/5] w-full overflow-hidden bg-slate-950">
              <img
                src={siteConfig.avatar || "/profile.jpg"}
                alt={siteConfig.name}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-102"
                loading="eager"
              />
            </div>

            <!-- Subtle Understated Badge -->
            <div class="absolute top-2.5 right-2.5 bg-slate-950/80 backdrop-blur-md border border-slate-800 rounded-md px-2 py-0.5 shadow-sm">
              <span class="text-[10px] font-mono text-slate-300">VIT Pune</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.7s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.15s;
  }

  .animation-delay-400 {
    animation-delay: 0.3s;
  }

  .animation-delay-600 {
    animation-delay: 0.45s;
  }
</style>
