---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-[#080b12] py-16 sm:py-20 md:py-24 min-h-[90vh] flex items-center text-slate-100"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Sleek dark radial glow overlay -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style={`background: radial-gradient(circle 800px at 15% 20%, rgba(15, 118, 110, 0.22) 0%, rgba(13, 21, 39, 0.4) 45%, #080b12 100%)`}
  >
  </div>

  <!-- Background Grid & Code Symbols -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-slate-800/40 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="hero-grid"
        width={160}
        height={160}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 160V.5H160" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols-dark"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text x="50" y="50" fill="#14b8a6" opacity="0.35" font-family="monospace" font-size="20" transform="rotate(-15)">&lt;/&gt;</text>
        <text x="160" y="100" fill="#14b8a6" opacity="0.3" font-family="monospace" font-size="18" transform="rotate(10)">{}</text>
        <text x="260" y="80" fill="#14b8a6" opacity="0.3" font-family="monospace" font-size="16" transform="rotate(-5)">=&gt;</text>
        <text x="100" y="220" fill="#14b8a6" opacity="0.35" font-family="monospace" font-size="20" transform="rotate(15)">[]</text>
        <text x="320" y="190" fill="#14b8a6" opacity="0.25" font-family="monospace" font-size="18" transform="rotate(-10)">&lt;&gt;</text>
        <text x="210" y="270" fill="#14b8a6" opacity="0.3" font-family="monospace" font-size="22" transform="rotate(5)">()</text>
      </pattern>
    </defs>
    <rect fill="url(#programming-symbols-dark)" width="100%" height="100%"></rect>
    <rect fill="url(#hero-grid)" width="100%" height="100%"></rect>
  </svg>

  <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-14 w-full py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Intro & Info -->
      <div class="lg:col-span-8 space-y-5">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-teal-500/40 text-teal-300 text-xs font-mono font-semibold tracking-wide animate-fade-in shadow-inner">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Available for SDE Internships • Summer 2027</span>
        </div>

        <div>
          <h2 class="text-slate-400 text-base sm:text-lg font-medium tracking-wide animate-fade-in">
            Hello! 👋
          </h2>
          <h1 class="mt-2 text-pretty text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white animate-fade-in animation-delay-200">
            I'm <span class="text-teal-400 bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-emerald-300">{siteConfig.name}</span>
          </h1>
          <p class="mt-4 text-pretty text-base sm:text-lg md:text-xl leading-relaxed text-slate-300 font-normal animate-fade-in animation-delay-400 max-w-2xl">
            {siteConfig.title}
          </p>
        </div>

        <!-- Quick Highlight Badges -->
        <div class="flex flex-wrap gap-2 text-xs font-mono animate-fade-in animation-delay-400 pt-1">
          <span class="px-3 py-1 rounded-lg bg-slate-900 border border-slate-700 text-slate-200">
            VIT Pune • CGPA 9.33
          </span>
          <span class="px-3 py-1 rounded-lg bg-teal-950/70 border border-teal-700/60 text-teal-300">
            ICST 2026 Researcher (IIT Patna)
          </span>
          <span class="px-3 py-1 rounded-lg bg-emerald-950/70 border border-emerald-700/60 text-emerald-300">
            513 TUF+ • 352 LeetCode • 1★ CodeChef
          </span>
        </div>

        <!-- Call to actions -->
        <div class="pt-2 flex flex-wrap items-center gap-4 animate-fade-in animation-delay-600">
          <a
            href="#projects"
            class="px-5 py-2.5 rounded-lg text-white font-medium text-sm transition-all shadow-lg bg-teal-600 hover:bg-teal-500 hover:shadow-teal-500/20"
          >
            Explore Projects →
          </a>
          <a
            href="#problem-solving"
            class="px-5 py-2.5 rounded-lg border border-teal-500/40 text-teal-200 font-medium text-sm bg-slate-900/90 hover:bg-slate-800 transition-colors shadow-sm flex items-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Live DSA Stats</span>
          </a>
        </div>

        <!-- Social Icons -->
        <div class="pt-4 flex flex-wrap gap-x-4 gap-y-3 text-slate-400 animate-fade-in animation-delay-600 items-center">
          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                title="Email Prasanna"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                title="GitHub Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.leetcode && (
              <a
                href={siteConfig.social.leetcode}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LeetCode"
                title="LeetCode Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-amber-500 hover:text-amber-300 hover:bg-slate-850 transition-all duration-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-3.3-.5-5-2.2-5-5V8l3-3h5a5 5 0 0 1 5 5v1" />
                  <path d="M8 12h8m-8 4h5" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.takeuforward && (
              <a
                href={siteConfig.social.takeuforward}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TakeUForward"
                title="TakeUForward Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-teal-500 hover:text-teal-300 transition-all duration-200 font-mono text-xs font-bold"
              >
                <span class="inline-block px-1.5 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-800">TUF</span>
              </a>
            )
          }
          {
            siteConfig.social?.codechef && (
              <a
                href={siteConfig.social.codechef}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="CodeChef"
                title="CodeChef Profile"
                class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 hover:border-amber-500 hover:text-amber-300 transition-all duration-200 font-mono text-xs font-bold"
              >
                <span class="inline-block px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800">CC</span>
              </a>
            )
          }
        </div>
      </div>

      <!-- Right Column: REDUCED SIZE Portrait Image Presentation -->
      <div class="lg:col-span-4 flex justify-center lg:justify-end animate-fade-in animation-delay-200">
        <!-- Compact, balanced image wrapper (reduced size) -->
        <div class="relative group w-48 sm:w-56 md:w-60">
          <!-- Ambient Glow Background -->
          <div
            class="absolute -inset-2 rounded-2xl blur-xl opacity-50 group-hover:opacity-80 transition-opacity duration-700 -z-10"
            style={`background: linear-gradient(135deg, ${siteConfig.accentColor}70, #10b98150, ${siteConfig.accentColor}40)`}
          ></div>

          <!-- Main Compact Image Frame -->
          <div class="relative overflow-hidden rounded-2xl border border-teal-500/50 bg-slate-900 shadow-2xl backdrop-blur-md">
            <!-- Constrained Aspect Ratio for compact profile look -->
            <div class="aspect-[4/5] w-full overflow-hidden bg-slate-950">
              <img
                src={siteConfig.avatar || "/profile.jpg"}
                alt={siteConfig.name}
                class="w-full h-full object-cover object-top filter grayscale contrast-110 brightness-95 transition-all duration-500 group-hover:scale-105 group-hover:contrast-115"
                loading="eager"
              />
            </div>

            <!-- Floating Top Micro-Badge -->
            <div class="absolute top-2.5 right-2.5 bg-slate-900/90 backdrop-blur-md border border-teal-500/40 rounded-lg px-2 py-1 shadow-md flex items-center gap-1">
              <span class="text-[10px] font-bold text-teal-300 font-mono">ICST '26</span>
              <span class="text-[9px] text-slate-400">IIT Patna</span>
            </div>

            <!-- Floating Bottom Info Pill (Compact) -->
            <div class="absolute bottom-2.5 left-2.5 right-2.5 bg-slate-900/95 backdrop-blur-md border border-slate-700/80 rounded-xl p-2 shadow-lg">
              <div class="flex items-center justify-between">
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <strong class="text-[11px] font-bold text-white tracking-tight">SDE Intern Track</strong>
                  </div>
                  <p class="text-[10px] text-teal-300 font-mono mt-0.5">VIT Pune • AI/ML</p>
                </div>
                <div class="text-right">
                  <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Summer</span>
                  <strong class="text-[11px] font-mono font-bold text-white">2027</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.7s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.15s;
  }

  .animation-delay-400 {
    animation-delay: 0.3s;
  }

  .animation-delay-600 {
    animation-delay: 0.45s;
  }
</style>
