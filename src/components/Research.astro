---
import { siteConfig } from "../config";

const achievements = siteConfig.achievements ?? [
  {
    title: siteConfig.publication.title,
    category: "Research Paper",
    venue: siteConfig.publication.venue,
    description: siteConfig.publication.description,
    badge: "Published Research",
    icon: "paper",
  },
];
---

<section id="research" class="section-shell bg-[#080b12] text-slate-100 border-t border-slate-800/80">
  <div class="section-grid">
    <div>
      <p class="eyebrow">05 / honors & leadership</p>
      <h2 class="section-title text-white">Achievements & Research</h2>
      <p class="mt-4 text-slate-400 leading-relaxed text-sm sm:text-base">
        Published research, patented innovation, competitive technical exhibition awards, and campus leadership.
      </p>
    </div>

    <div class="space-y-6">
      {achievements.map((item, index) => (
        <article class="p-6 rounded-2xl border border-slate-800 bg-[#0d1527] hover:border-slate-700 transition-all duration-300 shadow-xl">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-semibold font-mono uppercase tracking-wider text-teal-400">
              {item.venue}
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-slate-800 text-slate-300 border border-slate-700">
              {item.badge}
            </span>
          </div>

          <h3 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-white">
            {item.title}
          </h3>

          <p class="mt-2.5 text-base leading-relaxed text-slate-300">
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

