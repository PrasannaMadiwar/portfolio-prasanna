---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="section-shell bg-[#0a0e1a] text-slate-100 border-t border-slate-800/80">
      <div class="section-grid">
        <div>
          <p class="eyebrow">06 / background</p>
          <h2 class="section-title text-white">
            Education
          </h2>
        </div>

        <div>
          <div class="space-y-6">
            {siteConfig.education.map((edu) => (
              <div class="bg-[#0d1527] rounded-2xl border border-slate-800 p-6 shadow-xl transition-all duration-300 hover:border-slate-700">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                  <div>
                    <h3 class="text-lg sm:text-xl font-bold text-white">
                      {edu.degree}
                    </h3>
                    <p class="text-base font-mono text-teal-400 mt-0.5">
                      {edu.school}
                    </p>
                  </div>
                  <span class="text-xs sm:text-sm font-mono text-slate-400 mt-2 sm:mt-0">
                    {edu.dateRange}
                  </span>
                </div>

                <ul class="space-y-2">
                  {edu.achievements.map((achievement) => (
                    <li class="flex items-start">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-teal-400 mt-2 mr-3 flex-shrink-0" />
                      <span class="text-sm sm:text-base text-slate-300">
                        {achievement}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-8 border-t border-slate-800 pt-6">
            <h3 class="text-xs font-mono font-bold uppercase tracking-[0.14em] text-teal-400">Relevant Coursework</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {siteConfig.coursework.map((course) => <span class="tag tag-dark">{course}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
