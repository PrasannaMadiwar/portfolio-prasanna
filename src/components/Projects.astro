---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="section-shell bg-[#080b12] text-slate-100 border-t border-slate-850">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <p class="eyebrow">04 / selected work</p>
            <h2 class="section-title text-white">
              Projects
            </h2>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.projects.map((project, index) => {
                const Component = project.link ? "a" : "div";
                const linkProps = project.link
                  ? {
                      href: project.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`block relative p-6 sm:p-7 md:p-8 bg-[#0d1527] rounded-2xl border border-slate-800 shadow-xl transition-all duration-300 ${
                        project.link
                          ? "hover:border-slate-700 hover:bg-[#10192e] hover:-translate-y-0.5"
                          : ""
                      }`}
                    >
                      {project.link && (
                        <div class="absolute top-6 right-6 w-9 h-9 flex items-center justify-center bg-slate-900 border border-slate-700/80 rounded-full text-slate-300 transition-all duration-300 group-hover:text-white group-hover:border-slate-600">
                          <svg
                            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}

                      <div class="space-y-4">
                        <div>
                          <div class="flex items-center gap-3">
                            <span class="text-xs font-mono text-teal-400 font-bold">
                              0{index + 1}
                            </span>
                            {project.live && (
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono text-teal-300 border border-teal-800/60 bg-teal-950/60 font-medium">
                                Live Demo ↗
                              </span>
                            )}
                          </div>
                          <h3 class="text-xl sm:text-2xl font-bold text-white mt-1.5">
                            {project.name}
                          </h3>
                        </div>

                        <p
                          class={`text-base sm:text-lg text-slate-300 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}
                        >
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class="px-2.5 sm:px-3 py-1 bg-slate-900/90 text-slate-200 border border-slate-700/80 rounded-lg text-xs font-mono font-medium transition-all duration-300 group-hover:border-slate-600"
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                        {project.features && (
                          <ul class="space-y-2.5 border-t border-slate-800/80 pt-4">
                            {project.features.map((feature) => (
                              <li class="flex items-start text-sm leading-relaxed text-slate-400 gap-2.5">
                                <span class="inline-block w-1.5 h-1.5 rounded-full bg-teal-400 mt-2 shrink-0" />
                                <span>{feature}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {project.note && <p class="border-t border-slate-800/80 pt-4 text-sm font-mono text-teal-300">{project.note}</p>}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
